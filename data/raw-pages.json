    },
    "content": {
      "rendered": "\n<p class=\"wp-block-paragraph\"><strong>Terms and Conditions</strong></p>\n\n\n\n<p class=\"wp-block-paragraph\">By using this website, you agree to the following terms:</p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>All information provided is for general knowledge and devotional purpose only.</li>\n\n\n\n<li>We do our best to provide accurate information, but we are not affiliated with the official Guruvayur Temple authority.</li>\n\n\n\n<li>We are not responsible for actions taken based on information on this site.</li>\n\n\n\n<li>External links may lead to third-party sites. We are not responsible for their content or privacy policies.</li>\n\n\n\n<li>You may not copy or reuse our content without permission.</li>\n</ul>\n",
      "protected": false
