    "title": {
      "rendered": "Privacy Policy"
    },
    "content": {
      "rendered": "\n<p class=\"wp-block-paragraph\"><strong>Privacy Policy</strong></p>\n\n\n\n<p class=\"wp-block-paragraph\">This website, [YourSiteName], respects your privacy and is committed to protecting your personal data.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>What Information We Collect:</strong></p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Name and email (if you contact us)</li>\n\n\n\n<li>Anonymous traffic data via Google Analytics</li>\n</ul>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>How We Use Your Information:</strong></p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>To respond to your messages</li>\n\n\n\n<li>To improve site performance</li>\n</ul>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Cookies:</strong><br>This site uses cookies for better user experience and analytics. By using this site, you consent to the use of cookies.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Third-Party Services:</strong><br>We use third-party services like Google Analytics and social sharing plugins that may collect anonymous usage data.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Your Rights:</strong><br>You can request to view, update, or delete your personal data.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Contact Us:</strong><br>If you have questions about your privacy, contact us at [your email].</p>\n",
      "protected": false
    },
